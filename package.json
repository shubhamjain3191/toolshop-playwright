{
  "name": "toolshop-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI and API test suite for the Practice Software Testing \"Tool Shop\" demo application",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:firefox": "playwright test --project=firefox",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "ui": "playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://practicesoftwaretesting.com",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "playwright",
    "test-automation",
    "e2e",
    "api-testing",
    "javascript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "prettier": "^3.9.9",
    "zod": "^4.6.5"
  }
}
